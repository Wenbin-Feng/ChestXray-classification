# Model Configuration
MODEL_TYPE=vit
MODEL_NUM_CLASSES=3
MODEL_IMG_SIZE=224
MODEL_PRETRAINED=true

# ViT Specific
MODEL_VIT_PATCH_SIZE=16
MODEL_VIT_EMBED_DIM=768
MODEL_VIT_DEPTH=12
MODEL_VIT_NUM_HEADS=12

# Mamba Specific
MODEL_MAMBA_D_MODEL=768
MODEL_MAMBA_N_LAYER=12
MODEL_MAMBA_D_STATE=16
MODEL_MAMBA_D_CONV=4
MODEL_MAMBA_EXPAND=2

# Training Configuration
TRAIN_BATCH_SIZE=32
TRAIN_NUM_EPOCHS=10
TRAIN_LEARNING_RATE=0.0003
TRAIN_WEIGHT_DECAY=0.0001
TRAIN_NUM_WORKERS=4
TRAIN_SAVE_DIR=./checkpoints

# Data Configuration
DATA_TRAIN_DIR=/home/ubuntu/DETR/5.06组会/ChexRay/train/img
DATA_TEST_DIR=/home/ubuntu/DETR/5.06组会/ChexRay/test/img
# DATA_VAL_DIR=/path/to/validation

# Device Configuration
DEVICE_TYPE=auto

# App Configuration
SEED=42
DEBUG=false
