+class Predictor:
+    """Inference manager for chest X-ray classification."""
+    
+    # Class labels
+    LABELS = {0: "BACTERIA", 1: "NORMAL", 2: "VIRUS"}
+    
+    def __init__(self, model, device=None):
+        """
+        Args:
+            model: PyTorch model
